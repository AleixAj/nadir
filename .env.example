# Copia este archivo como .env.local y rellena los valores.

# Neon → botón "Connect" → cadena que empieza por postgresql://
DATABASE_URL=

# Better Auth: secreto aleatorio de 32+ caracteres y URL de la app
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud → Google Auth Platform → Clientes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Protege la ruta que revisa los precios automáticamente
CRON_SECRET=

# SerpApi: solo para cargar el catálogo de prueba (npm run catalog:seed)
SERPAPI_KEY=
