# Copy this file to .env.local and fill in the values.

# Neon: "Connect" button, the string that starts with postgresql://
DATABASE_URL=

# Better Auth: random secret (32+ characters) and the app URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google Cloud: Google Auth Platform > Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend: sign-up confirmation, password reset and price alert emails
# The sender has to use a domain verified in Resend
RESEND_API_KEY=
EMAIL_FROM="Nadir <avisos@aleixaj.com>"

# Protects the route that checks prices automatically
CRON_SECRET=

# Only needed to load the test catalog (npm run catalog:seed)
SERPAPI_KEY=
SERPER_API_KEY=
